# Copy this file to ".env" and paste your key. ".env" is git-ignored: never commit or share it.

# --- Groq (free tier, fast). Several models = fallback chain when one hits its rate limit ---
OPENAI_API_KEY=gsk_paste_your_groq_key_here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b

# --- OpenAI (paid) : use these 2 lines instead and delete OPENAI_BASE_URL ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
